  "item": [
    {
      "name": "Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Status is UP\", () => {",
              "    // Parse the JSON response for the checks below.",
              "    const responseJavaScript = pm.response.json();",
              "",
              "    pm.expect(responseJavaScript.status).to.eql(\"UP\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "status"
          ]
        },
        "description": "Check that the training API is available. No authentication is required."
      },
      "response": []
    },
    {
      "name": "Get all tools",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Parse the JSON response for the checks below.",
              "const responseJavaScript = pm.response.json();",
              "// Select the first available tool in the requested category.",
              "const tools = responseJavaScript.filter((tool) => tool.inStock === true);",
              "const tool = tools[0];",
              "",
              "// Keep the API ID as a number for the strict comparison in the next request.",
              "if (tool !== undefined) {",
              "    pm.globals.set(\"toolId\", tool.id);",
              "}",
              "",
              "pm.test(\"Tool found\", () => {",
              "    pm.expect(tool).to.be.an(\"object\");",
              "    pm.expect(tool.inStock).to.eql(true);",
              "",
              "    pm.expect(tool.category).to.eql(pm.collectionVariables.get(\"category\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tools?category={{category}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tools"
          ],
          "query": [
            {
              "key": "category",
              "value": "{{category}}"
            }
          ]
        },
        "description": "Select the first in-stock tool in the collection category and save its numeric ID globally. Stop if selection fails; an old global ID can otherwise remain."
      },
      "response": []
    },
    {
      "name": "Get a single tool",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Parse the JSON response for the checks below.",
              "const responseJavaScript = pm.response.json();",
              "",
              "// A manually entered string ID will not equal the numeric response ID.",
              "pm.test(\"Response toolId is as expected\", () => {",
              "    pm.expect(responseJavaScript.id).to.eql(pm.globals.get(\"toolId\"));",
              "});",
              "",
              "pm.test(\"Current-Stock available\", () => {",
              "    pm.expect(responseJavaScript[\"current-stock\"]).to.be.above(0);",
              "});",
              "",
              "// Collection Runner only: skip registration after manual setup.",
              "pm.execution.setNextRequest(\"Create a new order\");"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tools/:toolId",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tools",
            ":toolId"
          ],
          "variable": [
            {
              "key": "toolId",
              "value": "{{toolId}}"
            }
          ]
        },
        "description": "Check the selected tool ID and stock. In Collection Runner, continue at Create a new order, bypassing client registration. Send does not follow this jump."
      },
      "response": []
    },
    {
      "name": "Register a new API client",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"clientName\": \"Postman\",\n    \"clientEmail\": \"silva_{{$randomFirstName}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api-clients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api-clients"
          ]
        },
        "description": "Manual setup only: register a fictional test client, then copy accessToken into the local apiToken value. Do not share the token or save the response as an example."
      },
      "response": []
    },
    {
      "name": "Create a new order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Parse the JSON response for the checks below.",
              "const responseJavaScript = pm.response.json();",
              "// Share the created order ID with the remaining requests.",
              "pm.globals.set(\"orderId\", responseJavaScript.orderId);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"toolId\": {{toolId}},\n    \"customerName\": \"{{$randomFullName}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "description": "Create an order for the selected tool using generated customer data. Save orderId globally for the remaining requests."
      },
      "response": []
    },
